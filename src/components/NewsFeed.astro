---
import { feeds } from '../lib/news-model';
---
<section class="news-feed" data-news-feed aria-labelledby="news-feed-heading">
  <div class="workbench-heading"><div><div class="eyebrow">FROM DEVELOPER COMMUNITIES</div><h2 id="news-feed-heading">A little signal.</h2></div><a class="text-link" href="https://news.ycombinator.com/" target="_blank" rel="noopener noreferrer">Read on Hacker News ↗</a><a class="text-link" href="https://dev.to/" target="_blank" rel="noopener noreferrer">Read on DEV ?</a></div>
  <p class="news-intro">Technology, independent projects, and ideas worth a closer look. Headlines link to their publishers; conversations stay with each community.</p>
  <div class="news-controls" data-news-controls hidden><div class="filter-row" aria-label="News feeds">{Object.entries({...feeds, saved: 'Read later'}).map(([value,label]) => <button type="button" class="filter-button" data-news-kind={value} aria-pressed={value === 'top'}>{label}</button>)}</div><button class="button" type="button" data-news-refresh>Refresh ↻</button></div>
  <div class="reading-controls" data-reading-controls hidden><label class="reading-search"><span class="sr-only">Search loaded stories by title or website</span><input type="search" data-reading-search placeholder="Search these stories…"/></label><label>Sort<select data-reading-sort><option value="source">Feed / saved order</option><option value="time">Newest first</option><option value="score">Most points / reactions</option><option value="comments">Most comments</option></select></label><label><input type="checkbox" data-reading-unread/> Unread only</label><span data-reading-count></span><div class="reading-actions"><button type="button" data-reading-mark-visible disabled>Mark visible read (0)</button><button type="button" data-reading-undo disabled>Undo batch</button></div></div>
  <p class="news-status" role="status" aria-live="polite" data-reading-status hidden>Save up to 50 headlines in this browser. Mark stories read when you finish; article text is not saved.</p>
  <p class="news-status" role="status" aria-live="polite" data-news-status>Enable JavaScript to load headlines here, or visit the source above.</p>
  <ol class="news-stories" data-news-stories></ol>
  <p class="news-credit">Via the <a href="https://github.com/HackerNews/API" target="_blank" rel="noopener noreferrer">official Hacker News API ↗</a>. Cached in this browser for 10 minutes. Publication times are shown in your local time.</p>
</section>
<script>import '../scripts/news';</script>

---
import WorldLayout from '../layouts/WorldLayout.astro';
import '../styles/element-worlds.css';
interface Props {world:'pelagic'|'ember'}
const {world}=Astro.props,sea=world==='pelagic',title=sea?'Pelagic':'Ember',tools=sea?[['flow','Current'],['add','Life'],['light','Light'],['remove','Remove']]:[['lava','Pour'],['heat','Heat'],['cool','Cool'],['remove','Lift']];
---
<WorldLayout world={world} themeColor={sea?'#071d30':'#191318'} title={`${title} — ${sea?'a pocket of deep blue':'where the earth remembers'}`} description={sea?'Raise a luminous sea. Jellyfish, shoals and plankton respond to your currents.':'Pour, warm and cool a volcanic surface. Keep the patterns the heat leaves behind.'} skipLabel={`Skip to ${title}`}>
  <div id="element-world" data-world={world}>
    <header class="element-header"><a href="/worlds/">↖ Other skies</a><div class="element-brand">{title}<span>{sea?'BELOW THE FAMILIAR':'MATTER / IN THE MAKING'}</span></div><button id="element-panel-toggle" aria-controls="element-panel" aria-expanded="false">{sea?'Your sea':'Your surface'} <span>☷</span></button></header>
    <main id="main"><div id="element-stage" class="element-stage" tabindex="0" role="region" aria-label={`${title} canvas. Keys 1–4 select tools, arrows move the brush, Enter applies, Space pauses.`}></div><div class="element-poem" aria-hidden="true"><span>{sea?'DIMENSION / 02':'DIMENSION / 03'}</span><h1>{sea?'A quieter':'Not quite'}<br/><em>{sea?'kind of light.':'solid.'}</em></h1><p>{sea?'Make a current. See who follows.':'A little heat changes everything.'}</p></div>
      <div id="element-loading" class="element-loading">{sea?'Waiting for the tide…':'Finding the heat…'}</div>
      <div class="element-dock"><p id="element-hint">{sea?'Drag through the water to leave a current.':'Draw a little molten earth. Give it time to move.'}</p><div class="element-tools" role="toolbar" aria-label="World tools">{tools.map(([tool,label],i)=><button data-element-tool={tool} aria-pressed={i===0}><span>{i+1}</span>{label}</button>)}<i></i><button id="element-play" aria-pressed="false">Pause</button><button id="element-step">Step</button><i></i><button id="element-quick-undo" aria-label="Undo last edit" title="Undo · Ctrl/⌘ Z">↶</button><button id="element-quick-redo" aria-label="Redo last edit" title="Redo · Ctrl/⌘ Shift Z">↷</button></div><p id="element-status" role="status" aria-live="polite">Local by nature. No uploads, no accounts.</p></div>
      <button id="element-backdrop" class="world-panel-backdrop" tabindex="-1" aria-label="Close settings" hidden></button><aside id="element-panel" class="element-panel" hidden aria-label="World settings"><div class="element-panel-heading"><h2>{sea?'A sea of':'Leave a'}<br/><em>{sea?'your own.':'trace.'}</em></h2><button id="element-panel-close" aria-label="Close settings">×</button></div><p id="element-count" class="element-small"></p>
        <section><h3>{sea?'WHAT LIVES HERE':'SHAPE THE SURFACE'}</h3>{sea&&<label>Life <select id="element-kind"><option value="jelly">Moon jelly · one</option><option value="fish">Silver shoal · eight</option><option value="plankton">Living sparks · twelve</option></select></label>}<label>Brush size <input id="element-radius" type="range" min="0.01" max="0.12" step="0.005" value="0.045"/></label><label>Strength <input id="element-strength" type="range" min="0.1" max="1" step="0.05" value="0.7"/></label><div class="element-row"><button id="element-undo">Undo</button><button id="element-redo">Redo</button></div></section>
        <section><h3>{sea?'THE WATER AROUND THEM':'THE LIFE OF THE MATERIAL'}</h3>{sea?<><label>Current direction <input id="element-direction" data-element-param="direction" type="range" min="0" max="360" value="15"/></label><label>Current strength <input id="element-current" data-element-param="strength" type="range" min="0" max="1" step="0.01" value="0.25"/></label><label>Ambient light <input id="element-brightness" data-element-param="brightness" type="range" min="0" max="1" step="0.01" value="0.4"/></label></>:<><label>Cooling rate <input id="element-cooling" data-element-param="cooling" type="range" min="0" max="1" step="0.01" value="0.3"/></label><label>Flow <input id="element-fluidity" data-element-param="fluidity" type="range" min="0" max="1" step="0.01" value="0.55"/></label><p class="element-small">A stylized thermal sandbox, not a geological prediction. Heat does not create matter; cooling does not erase it.</p></>}</section>
        <section><h3>YOUR VIEW</h3><label>Quality <select id="element-quality"><option value="auto">Automatic</option><option value="high">High</option><option value="low">Low</option></select></label><div class="element-row"><button id="element-reset-view">Reset view</button><button id="element-motion">Motion: Full</button></div></section>
        <section><h3>KEEP THIS WORLD</h3><label>Name <input id="element-name" maxlength="80"/></label><div class="element-row"><button id="element-save">Save new copy</button><button id="element-png">Export PNG ↗</button></div><div class="element-row"><button id="element-export">Export world</button><button id="element-import">Import world</button><input id="element-file" type="file" accept=".json" hidden/></div><button id="element-send">Prepare for Image Bench ↗</button><a id="element-image-link" href="/tools/image/" target="_blank" rel="noopener" hidden>Open prepared picture ↗</a><p id="element-dirty" class="element-small">Not saved on this device.</p></section>
        <section><h3>BEGIN AGAIN</h3><label>Seed <input id="element-seed" type="number" min="0" max="4294967295" step="1" value="17"/></label><button id="element-new">New seeded world</button></section><section><h3>YOUR COLLECTION</h3><div id="element-library">No saved copies yet.</div></section>
        <details><summary>A few ways to be here</summary><p>One finger or a mouse stroke uses your chosen tool. Editing pauses time; releasing restores the previous pace. Undo and redo pause the world and restore an entire edit snapshot, up to 30 edits or 32 MiB.</p><p>Focus the canvas: 1–4 change tools, arrows move the brush, Enter applies, Space pauses, Ctrl/⌘ Z undoes and Shift Z redoes. Controls never paint through to the canvas.</p><p>{sea?'Limits: 24 jellyfish, 160 fish, 240 plankton and six lights. No feeding, breeding or loss of creatures over time.':'Edges are sealed. Pour adds matter; Lift removes it. Cold material solidifies and retains cracks; reheating lets it flow again.'}</p><p>Only explicit saves are stored. Keep a world file for a portable backup. PNG is a picture, not an editable world. Lower quality changes visual detail, not your world.</p></details>
      </aside>
    </main><noscript><p class="element-noscript">Enable JavaScript for this Canvas 2D world. WebGL is not required. <a href="/worlds/">Return to other skies</a>.</p></noscript>
  </div><script>import '../scripts/element-world';</script>
</WorldLayout>

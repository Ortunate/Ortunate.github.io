---
import {games} from '../data/catalog';
---
<section class="wrap offline-panel" data-offline><h2>Take a game with you</h2><p>Download while online, then reopen this Play page offline. Choose individual games; storage is limited to 20 MiB. Your browser may clear downloads. Removing a download keeps your game progress.</p><p role="status" data-offline-status>Checking offline support…</p><div class="offline-list">{games.map(g=><div class="offline-row" data-offline-game={g.slug}><span>{g.title}</span><button class="button" data-download disabled>Download / Update</button><button class="button" data-remove disabled>Remove download</button><small data-offline-size>Not downloaded</small></div>)}</div></section>
<script>import '../scripts/offline';</script>
<style>.offline-panel{margin-block:2rem;padding:1.5rem;border:1px solid var(--line);border-radius:16px}.offline-list{display:grid;gap:12px}.offline-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.offline-row>span{min-width:180px}.offline-row button{min-height:44px}</style>

---
import controllerUrl from '../scripts/appearance.js?url&no-inline';
import { themes } from '../lib/appearance';
---
<div class="appearance-actions"><button class="appearance-open" data-appearance-src={controllerUrl} type="button" aria-haspopup="dialog" aria-controls="appearance-dialog">Theme colors</button>
<button class="mode-toggle" type="button" aria-label="Switch color mode" title="Switch color mode"><span aria-hidden="true">◐</span></button></div>
<span class="mode-status" role="status" aria-live="polite"></span>
<dialog id="appearance-dialog" class="appearance-dialog" aria-labelledby="appearance-title">
  <form method="dialog"><h2 id="appearance-title">Appearance</h2><button aria-label="Close appearance settings" class="appearance-close">×</button></form>
  <fieldset disabled><legend>Theme color</legend><div class="appearance-colors">{themes.map(theme => <label><input type="radio" name="appearance-theme" value={theme} /><span class={`appearance-swatch swatch-${theme}`} aria-hidden="true"></span>{theme[0].toUpperCase() + theme.slice(1)}</label>)}</div></fieldset>
  <fieldset disabled><legend>Device preference</legend><label><input type="checkbox" name="appearance-system" /> Follow system appearance</label></fieldset>
  <p class="appearance-note">System follows your device. World scenery keeps its original colors.</p>
  <p class="appearance-status" role="status" aria-live="polite"></p>
</dialog>
<script is:inline data-appearance-loader>
(() => {
  const root=document.documentElement, toggle=document.querySelector('.mode-toggle'), open=document.querySelector('.appearance-open');
  const sync=()=>{const dark=root.dataset.colorMode==='dark', label=dark?'Switch to light mode':'Switch to dark mode';toggle.firstElementChild.textContent=dark?'☀':'☾';toggle.setAttribute('aria-label',label);toggle.title=label;};
  window.addEventListener('appearancechange',sync);sync();
  toggle.addEventListener('click',()=>{
    const mode=root.dataset.colorMode==='dark'?'light':'dark';
    window.dispatchEvent(new CustomEvent('appearanceinput',{detail:{mode}}));
    const status=document.querySelector('.mode-status');
    try{localStorage.setItem('ortunate:color-mode:v1',mode);status.textContent=mode==='dark'?'Night mode enabled.':'Day mode enabled.';}
    catch{status.textContent='Applied for this page. Preference could not be saved.';}
  });
  open.addEventListener('click',async()=>{
    open.disabled=true;
    try{(await import(open.dataset.appearanceSrc)).openAppearance();}
    catch{const dialog=document.querySelector('#appearance-dialog');dialog.querySelector('.appearance-status').textContent='Settings could not load. Close and try again.';if(!dialog.open)dialog.showModal();}
    finally{open.disabled=false;}
  });
})();
</script>

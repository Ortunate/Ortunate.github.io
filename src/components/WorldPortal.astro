---
const {compact=false}=Astro.props;
---
<a href="/worlds/windward/" class:list={['world-portal',{compact}]} aria-label="Enter Windward, a living garden beyond the orbit">
  <div class="portal-landscape" aria-hidden="true"><div class="portal-sun"></div><div class="portal-cloud"></div><div class="portal-hill far"></div><div class="portal-hill near"></div><div class="portal-meadow">{Array.from({length:48},(_,i)=><i style={`--x:${i*2.15}%;--h:${35+(i*17)%70}px;--delay:${-i*.23}s;--lean:${(i%7)-3}deg`}></i>)}</div><span class="portal-coordinate">35° N / A SOFTER KIND OF GRAVITY</span></div>
  <div class="portal-caption"><span>DIMENSION 01</span><strong>Windward</strong><span>Step into the daylight ↗</span></div>
</a>
<style>
.world-portal{position:relative;display:block;isolation:isolate;color:#eff3df;text-decoration:none;border:1px solid #e0e6c947;border-radius:48% 48% 8px 8px / 30% 30% 8px 8px;overflow:hidden;background:#bdd8d3;box-shadow:0 0 90px #bbcfa917;transition:box-shadow .5s,transform .5s;view-transition-name:world-portal}.world-portal:hover{box-shadow:0 0 100px #c6e2ae38;transform:translateY(-4px)}.portal-landscape{height:440px;position:relative;overflow:hidden;background:linear-gradient(#96bbcb,#cfe0d4 66%,#e9e6c8)}.portal-sun{position:absolute;width:90px;height:90px;border-radius:50%;top:80px;right:23%;background:#fff8d4;box-shadow:0 0 65px 25px #fff4c83b}.portal-cloud{position:absolute;left:-10%;top:95px;width:85%;height:80px;background:#f4f4e87a;filter:blur(25px);border-radius:50%;transform:rotate(-8deg)}.portal-hill{position:absolute;width:145%;height:260px;left:-20%;bottom:-95px;background:#718c60;border-radius:50% 50% 0 0;transform:rotate(-10deg)}.portal-hill.far{bottom:-13px;left:8%;background:#a0b894;transform:rotate(13deg)}.portal-meadow{position:absolute;inset:65% 0 0;overflow:hidden}.portal-meadow i{position:absolute;bottom:-5px;left:var(--x);width:7px;height:var(--h);background:linear-gradient(#d9de97,#65784d);border-radius:100% 0 0;transform-origin:bottom;transform:rotate(var(--lean));animation:portal-grass 4s ease-in-out infinite alternate;animation-delay:var(--delay);animation-play-state:paused}.world-portal[data-active=true] i{animation-play-state:running}.portal-coordinate{position:absolute;top:42%;left:20px;color:#2f514660;font:9px monospace;letter-spacing:.14em;writing-mode:vertical-rl}.portal-caption{position:relative;padding:24px 28px 28px;background:#172c23;display:flex;flex-direction:column;gap:12px}.portal-caption>span{font:10px monospace;letter-spacing:.12em;color:#c0cdb6}.portal-caption strong{font:italic 48px Georgia,serif;letter-spacing:-.04em;color:#edf0d7}.compact .portal-landscape{height:280px}@keyframes portal-grass{to{transform:rotate(13deg)}}@media(prefers-reduced-motion:reduce){.portal-meadow i{animation:none}.world-portal{transition:none}}:global(html[data-motion=reduced]) .portal-meadow i{animation:none}@media(max-width:600px){.portal-landscape{height:340px}}
</style>

---
import {worlds} from '../data/worlds';
interface Props {world:'pelagic'|'ember'}
const {world}=Astro.props,sea=world==='pelagic',entry=worlds.find(w=>w.id===world)!;
---
<a class:list={['element-portal',world]} href={entry.path} aria-label={`Enter ${entry.name}`}>
  <div class="element-portal-picture" aria-hidden="true"><svg viewBox="0 0 400 300"><defs><radialGradient id={`portal-glow-${world}`}><stop offset="0" stop-color={sea?'#78ebd0':'#ffb960'} stop-opacity=".3"/><stop offset="1" stop-color={sea?'#78ebd0':'#ffb960'} stop-opacity="0"/></radialGradient></defs>
    {sea?<><path d="M 110 0 L 30 300 L 180 300 L 160 0" fill="#72baba" opacity=".035"/><circle cx="260" cy="100" r="110" fill={`url(#portal-glow-${world})`}/>{[0,1,2].map((i)=><g class="portal-jelly" style={`--delay:${-i*1.7}s`} transform={`translate(${110+i*80},${100+(i%2)*55}) scale(${.7+i*.12})`}><path d="M -32 9 C -33 -41, 35 -41, 32 9 Q 0 29 -32 9" fill="#94e6de22" stroke="#a3e8e688"/><path d="M -17 15 Q -34 49 -9 83 M -6 18 Q 9 52 -6 93 M 9 17 Q -4 48 18 78 M 23 14 Q 43 58 22 91" fill="none" stroke="#8cd9e155"/></g>)}{Array.from({length:18},(_,i)=><circle cx={35+(i*71)%330} cy={50+(i*43)%230} r={i%3===0?1.5:.7} fill="#98e5d7" opacity=".3"/>)}</>:<><rect width="400" height="300" fill="#17151a"/><path class="portal-lava-wide" d="M -20 220 Q 95 145 140 185 T 280 126 T 440 35" fill="none" stroke="#ce5c32" stroke-width="34"/><path class="portal-lava" d="M -20 220 Q 95 145 140 185 T 280 126 T 440 35" fill="none" stroke="#ffd295" stroke-width="5"/><path d="M 24 0 L 63 75 L 46 119 L 92 162 M 330 300 L 302 234 L 320 170 L 286 148 M 145 186 L 173 240 L 143 283 M 208 0 L 236 55 L 223 142" stroke="#9e674933" stroke-width="1" fill="none"/><circle class="portal-heat" cx="210" cy="155" r="135" fill={`url(#portal-glow-${world})`}/></>}
  </svg><span>{sea?'02 / BELOW THE FAMILIAR':'03 / MATTER IN THE MAKING'}</span></div><div class="element-portal-copy"><span>{sea?'TEND A LUMINOUS SEA':'SHAPE A THERMAL LANDSCAPE'}</span><h3>{entry.name}</h3><p>{entry.description}</p><span>Enter this world ↗</span></div>
</a>
<style>.element-portal{display:block;overflow:hidden;border:1px solid #a9c3ce30;border-radius:48% 48% 8px 8px / 25% 25% 8px 8px;background:#0c202c;transition:transform .4s,border-color .4s;text-decoration:none;color:#d6ebe4}.element-portal.ember{border-radius:4px;background:#21191b;border-color:#c39c7230}.element-portal:hover{transform:translateY(-4px);border-color:#d4e2c466}.element-portal-picture{position:relative;aspect-ratio:4/3;background:linear-gradient(#0b2c3b,#07111f);overflow:hidden}.element-portal-picture svg{display:block;width:100%;height:100%}.element-portal-picture>span{position:absolute;bottom:15px;left:22px;font:8px monospace;letter-spacing:.12em;color:#a1beb180}.element-portal-copy{padding:25px}.element-portal-copy>span{font:9px monospace;letter-spacing:.1em;color:#9bbcb7}.element-portal-copy h3{font:italic 43px Georgia,serif;letter-spacing:-.04em;margin:15px 0}.element-portal-copy p{font-size:12px;line-height:1.9;color:#92abb1;min-height:46px;margin-bottom:23px}.ember .element-portal-copy h3{font-style:normal;color:#e2c7a7}.ember .element-portal-copy p,.ember .element-portal-copy>span{color:#b79b89}.portal-jelly{animation:portal-float 7s ease-in-out infinite alternate;animation-delay:var(--delay);animation-play-state:paused}.portal-lava-wide{opacity:.5;animation:portal-heat 4s ease-in-out infinite alternate;animation-play-state:paused}.portal-heat{animation:portal-heat 5s ease-in-out infinite alternate;animation-play-state:paused}.element-portal[data-active=true] svg *{animation-play-state:running}@keyframes portal-float{to{translate:3px -9px}}@keyframes portal-heat{to{opacity:.3}}:global(html[data-motion=reduced]) .element-portal *{animation:none!important}@media(prefers-reduced-motion:reduce){.element-portal *{animation:none!important}}</style>
<script>
  const portals=[...document.querySelectorAll<HTMLElement>('.element-portal,.world-portal')],visible=new Set<Element>();const sync=()=>portals.forEach(p=>p.dataset.active=String(visible.has(p)&&!document.hidden));const observer=new IntersectionObserver(entries=>{for(const e of entries){if(e.isIntersecting)visible.add(e.target);else visible.delete(e.target);}sync();});portals.forEach(p=>observer.observe(p));document.addEventListener('visibilitychange',sync);window.addEventListener('pagehide',e=>{portals.forEach(p=>p.dataset.active='false');if(!e.persisted)observer.disconnect();});window.addEventListener('pageshow',sync);
</script>

---
import Layout from '../../layouts/Layout.astro';
const studies=[
  {slug:'living',number:'01',kind:'GROW / MATERIAL',title:'Living Canvas',description:'Plant a texture. Hold a detail. Sculpt the light.',href:'/studio/living-canvas/',action:'Grow a study',note:'GENERATIVE PAINTING · PNG & EDITABLE ART'},
  {slug:'kinetic',number:'02',kind:'BUILD / MOTION',title:'Kinetic Workshop',description:'A little gravity. A small invention. A puzzle of your own.',href:'/play/kinetic/?mode=1',action:'Build a machine',note:'MECHANICAL PLAY · CHALLENGES & DESIGNS'},
  {slug:'sound',number:'03',kind:'WEAVE / SOUND',title:'Sound Loom',description:'Six threads. Repeating rhythms. Something only you would make.',href:'/studio/sound-loom/',action:'Weave a rhythm',note:'LOCAL SYNTHESIS · WAV & EDITABLE SCORES'},
];
---
<Layout title="Create — small instruments for curious people" description="Grow an artwork, build a machine, weave a rhythm. Three local creative studios, no accounts or uploads.">
  <section class="create wrap"><header class="create-heading"><div class="eyebrow">MAKE A LITTLE SOMETHING</div><h1>Less watching.<br/><em>More making.</em></h1><p>Three small instruments for your curiosity.<br/>Start with a gesture. Keep what emerges.</p></header>
    <div class="create-studies">{studies.map(study=><a class:list={['create-card',study.slug]} href={study.href}><div class="create-art" aria-hidden="true"><svg viewBox="0 0 500 320">
      {study.slug==='living'&&<g class="create-drift">{Array.from({length:23},(_,i)=><path d={`M ${-50+i*25} 330 C ${220+i*9} ${110-i*5}, ${-120+i*22} ${170+i*2}, ${130+i*24} -30`} fill="none" stroke={i%3===0?'#baa88a':'#718675'} stroke-width={i%3===0?7:3} opacity={.3+i%4*.14}/>)}</g>}
      {study.slug==='kinetic'&&<g><path d="M 70 90 L 250 140 M 260 210 L 420 170" stroke="#c9c9b3" stroke-width="9" stroke-linecap="round"/><g class="create-turn"><path d="M 180 215 L 310 155" stroke="#c5ac84" stroke-width="10" stroke-linecap="round"/><circle cx="245" cy="185" r="10" fill="#e5d7b7"/></g><circle class="create-ball" cx="115" cy="90" r="9" fill="#a8c2be"/><path d="M 390 250 L 390 279 L 450 279 L 450 250" stroke="#819e8d" stroke-width="6" fill="none"/></g>}
      {study.slug==='sound'&&<g>{Array.from({length:6},(_,i)=><g class="create-thread" style={`--delay:${i*-.3}s`}><path d={`M 30 ${65+i*37} C 165 ${150+i*9}, 310 ${30+i*40}, 470 ${65+i*37}`} fill="none" stroke={['#cba679','#be8f85','#c7c196','#90aca3','#8395b4','#ad9cbf'][i]} stroke-width="2"/><circle cx={110+i*51} cy={83+i*30} r="4" fill="#e1d3b5"/></g>)}</g>}
    </svg><span class="create-number">{study.number}</span></div><div class="create-copy"><span class="create-kind">{study.kind}</span><h2>{study.title}</h2><p>{study.description}</p><div class="create-action">{study.action}<span>↗</span></div><span class="create-note">{study.note}</span></div></a>)}</div>
    <div class="create-footer"><a href="/tools/image/">Finish in Image Bench ↗</a><a href="/tools/color/">Refine a palette ↗</a><span>LOCAL BY DESIGN</span><p>Each studio keeps its own library on this device. Export editable files for a backup. No account, no cloud sync, no automatic sound.</p><a href="/explore/?category=Create">Find your next creative detour ↗</a></div>
  </section>
</Layout>
<style>
.create{padding-block:55px 70px}.create-heading{margin-bottom:48px}.create-heading h1{font-size:clamp(46px,6vw,76px);letter-spacing:-.055em;line-height:1.05;margin:25px 0}.create-heading em{font-family:Georgia,serif;font-weight:400;color:#cfbf9f}.create-heading p{color:#9da9a5;font-size:15px;line-height:1.9}.create-studies{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.create-card{border:1px solid #384239;border-radius:10px;background:#141c18;overflow:hidden}.create-art{aspect-ratio:1.56;position:relative;background:radial-gradient(ellipse at 60% 40%,#394238,#10191a);overflow:hidden}.create-art svg{width:100%;height:100%;display:block}.create-number{position:absolute;left:20px;top:18px;font:10px monospace;letter-spacing:.1em;color:#bac2ae}.create-copy{padding:26px}.create-kind{font:9px monospace;letter-spacing:.13em;color:#a8b59c}.create-copy h2{font-size:27px;letter-spacing:-.045em;margin:17px 0}.create-copy p{font-size:13px;line-height:1.8;color:#9ba79c;min-height:70px}.create-action{display:flex;justify-content:space-between;margin:28px 0 24px;font-size:13px;color:#dbcfb2}.create-note{font:8px/1.8 monospace;color:#7e9280}.create-card:hover{border-color:#b9c1a1}.create-footer{border-top:1px solid #354139;padding-top:28px;margin-top:44px;display:flex;align-items:center;gap:35px}.create-footer>span{font:10px monospace;color:#adbaa5;white-space:nowrap}.create-footer p{font-size:12px;line-height:1.9;color:#91a08e;max-width:490px}.create-footer>a{font-size:12px;color:#cec4a6;margin-left:auto}.create-drift{animation:create-drift 12s ease-in-out infinite alternate}.create-turn{transform-origin:245px 185px;animation:create-turn 8s ease-in-out infinite alternate}.create-ball{animation:create-ball 5s ease-in-out infinite alternate}.create-thread{animation:create-thread 3s ease-in-out infinite alternate;animation-delay:var(--delay)}.create-art g,.create-ball{animation-play-state:paused}.create-card[data-active=true] .create-art g,.create-card[data-active=true] .create-ball{animation-play-state:running}@keyframes create-drift{to{transform:translate(15px,-10px)}}@keyframes create-turn{to{transform:rotate(38deg)}}@keyframes create-ball{to{transform:translate(110px,28px)}}@keyframes create-thread{to{opacity:.5;transform:translateY(3px)}}html[data-motion=reduced] .create-art *{animation:none}@media(prefers-reduced-motion:reduce){.create-art *{animation:none!important}}@media(max-width:1000px){.create-studies{gap:12px}.create-copy{padding:20px}.create-copy h2{font-size:23px}.create-footer{flex-wrap:wrap}}@media(max-width:760px){.create-studies{grid-template-columns:1fr}.create-card{display:grid;grid-template-columns:1fr 1fr}.create-art{height:100%;aspect-ratio:auto}.create-copy p{min-height:0}.create-footer{display:block}.create-footer p{margin:15px 0}.create-footer>a{display:inline-block}}@media(max-width:450px){.create-card{display:block}.create-art{aspect-ratio:1.8}.create-copy{padding:24px}}
</style>
<script>
  const cards=[...document.querySelectorAll<HTMLElement>('.create-card')],visible=new Set<Element>();
  const refresh=()=>cards.forEach(card=>card.dataset.active=String(!document.hidden&&visible.has(card)));
  const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting)visible.add(entry.target);else visible.delete(entry.target);}refresh();});cards.forEach(card=>observer.observe(card));document.addEventListener('visibilitychange',refresh);window.addEventListener('pagehide',()=>observer.disconnect());
</script>

---
import Layout from '../../layouts/Layout.astro';
import {utilities} from '../../data/catalog';
export function getStaticPaths(){return utilities.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;const slug=entry.slug;
---
<Layout title={entry.title} description={entry.description}><section class="page-section wrap workspace-tools" data-utility={slug}><div class="detail-heading"><div><a class="back-link" href="/tools/">← Back to the toolbox</a><h1>{entry.title}</h1><p>{entry.description}</p></div><span class="privacy-label">ONLY IN YOUR BROWSER</span></div><div class="utility-surface">
{slug==='timer'&&<><div class="timer-large" id="timer-readout" role="timer">25:00</div><progress class="timer-progress-v2" id="timer-progress" value="1" max="1" aria-label="Session remaining"></progress><div class="utility-fields"><label>Focus minutes<input type="number" id="focus-length" min="1" max="180" value="25"/></label><label>Break minutes<input type="number" id="break-length" min="1" max="60" value="5"/></label></div><div class="action-row"><button class="button primary" data-action="start">Start session</button><button class="button" data-action="reset">Reset</button><button class="button" data-action="focus">Focus</button><button class="button" data-action="break">Break</button></div></>}
{(slug==='json'||slug==='text'||slug==='encoding')&&<><label for="utility-input">{slug==='json'?'Your JSON':'Your text'}</label><textarea id="utility-input" spellcheck="false" placeholder={slug==='json'?'Paste JSON here…':'Type or paste here…'} maxlength="2000000"></textarea>{slug==='encoding'&&<label>Conversion<select id="encoding-kind"><option value="base64">Base64 (UTF-8)</option><option value="url">URL component</option></select></label>}<div class="action-row">{slug==='json'&&<><button class="button primary" data-action="format">Format JSON</button><button class="button" data-action="compact">Compact</button></>}{slug==='encoding'&&<><button class="button primary" data-action="encode">Encode</button><button class="button" data-action="decode">Decode</button></>}<button class="button" data-action="example">Try an example</button><button class="button" data-action="clear">Clear</button></div></>}
{slug==='timestamp'&&<><div class="utility-fields"><label>Timestamp<input type="text" id="timestamp-input" inputmode="decimal" placeholder="1750000000"/></label><label>Timestamp unit<select id="timestamp-unit"><option value="seconds">Seconds</option><option value="milliseconds">Milliseconds</option></select></label><label>Local date and time<input type="datetime-local" step="1" id="date-input"/></label><div><p class="help-text" id="timezone-label"></p></div></div><div class="action-row"><button class="button primary" data-action="to-date">Timestamp → date</button><button class="button" data-action="to-timestamp">Date → timestamp</button><button class="button" data-action="now">Use now</button><button class="button" data-action="clear">Clear</button></div></>}
{slug==='color'&&<><div class="utility-fields"><label>First color<input type="text" id="color-a" value="#ad99e5"/></label><label>Second color<input type="text" id="color-b" value="#c6eaa5"/></label><label>Gradient angle<input type="range" id="color-angle" min="0" max="360" value="135"/></label><label>Pick first color<input type="color" id="color-picker" value="#ad99e5"/></label></div><div id="color-preview" class="color-preview"></div><div class="action-row" aria-label="Copy first color or gradient">{['hex','rgb','hsl','css'].map(format=><button class="button" data-copy-format={format}>Copy {format.toUpperCase()}</button>)}</div><div class="action-row"><button class="button primary" data-action="color">Update colors</button><button class="button" data-action="example">Reset example</button></div></>}
{slug==='regex'&&<><div class="utility-fields"><label>Expression<input type="text" id="regex-pattern" value="\b\w+@\w+\.\w+\b" spellcheck="false"/></label><label>Flags<input type="text" id="regex-flags" value="g" spellcheck="false"/></label></div><label>Test text<textarea id="utility-input" spellcheck="false" maxlength="2000000" placeholder="Paste text to search…"></textarea></label><div class="action-row"><button class="button primary" data-action="regex">Run expression</button><button class="button" data-action="example">Try an example</button><button class="button" data-action="clear">Clear</button></div><div id="regex-highlight" class="match-preview" aria-label="Highlighted matches" hidden></div></>}
{slug==='password'&&<><div class="utility-fields"><label>Length<input type="number" id="password-length" min="4" max="128" value="20"/></label></div><div class="check-row">{[['upper','A–Z'],['lower','a–z'],['digits','0–9'],['symbols','Symbols']].map(([value,label])=><label><input type="checkbox" name="password-set" value={value} checked/>{label}</label>)}</div><div class="action-row"><button class="button primary" data-action="generate">Generate password</button><button class="button" data-action="clear">Clear</button></div><p class="help-text">Each selected character set appears at least once. Passwords are never saved.</p></>}
{slug==='units'&&<><div class="utility-fields"><label>Category<select id="unit-category">{['Length','Mass','Temperature','Area','Volume'].map(v=><option>{v}</option>)}</select></label><label>Value<input type="number" id="unit-value" value="1" step="any"/></label><label>From<select id="unit-from"></select></label><label>To<select id="unit-to"></select></label></div><div class="action-row"><button class="button primary" data-action="convert">Convert</button><button class="button" data-action="swap">Swap units ⇄</button><button class="button" data-action="example">Reset example</button></div></>}
{slug==='draw'&&<><label>Candidates, one per line<textarea id="utility-input" placeholder="Take a walk&#10;Read a chapter&#10;Make something" maxlength="200000"></textarea></label><div class="utility-fields"><label>Number of results<input type="number" id="draw-count" min="1" max="1000" value="1"/></label><label class="check-row"><input type="checkbox" id="draw-unique" checked/>No repeated candidates</label></div><div class="action-row"><button class="button primary" data-action="draw">Draw something ↗</button><button class="button" data-action="example">Try an example</button><button class="button" data-action="clear">Clear</button></div></>}
{slug!=='timer'&&<><pre class="utility-output" id="utility-output" aria-label="Result" tabindex="0">Your result will appear here.</pre><div class="action-row"><button class="button" data-action="copy">Copy {slug==='text'?'text':'result'}</button></div></>}
<p class="work-status" id="utility-status" role="status"></p></div></section><script>import '../../scripts/utilities';</script></Layout>

---
import Layout from '../../layouts/Layout.astro';
import {visuals} from '../../data/catalog';
export function getStaticPaths(){return visuals.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const special:Record<string,[string,number,number,number]>={orbit:['Orbit spread',1,3,1.8],ribbons:['Ribbon count',3,16,8],repulsion:['Field density',12,40,24],gravity:['Particle count',100,1200,550],flow:['Flow detail',10,50,26],ripple:['Wave frequency',10,60,30],aurora:['Curtain layers',3,14,7],fractal:['Complexity',4,12,8],kaleidoscope:['Symmetry',3,16,8],mesh:['Mesh density',10,32,20],flock:['Flock size',30,180,85],tunnel:['Star density',40,120,80]};
const [label,min,max,value]=special[entry.slug];
---
<Layout title={entry.title} description={entry.description}><section class="page-section wrap" data-visual-detail>
<div class="detail-heading"><div><a class="back-link" href="/visuals/">← All visual studies</a><div class="eyebrow">STUDY {entry.icon} / {entry.category.toUpperCase()}</div><h1>{entry.title}</h1><p>{entry.description}</p></div><span class="privacy-label">MOVE. TOUCH. EXPLORE.</span></div>
<div class="workspace-layout"><div><div class="stage-wrap visual-stage" id="visual-stage"><canvas id="visual-canvas" data-visual={entry.slug} tabindex="0" aria-label={`${entry.title} interactive canvas. Focus to use arrow keys, Enter, Space, and R.`}/><span class="stage-caption">{entry.title.toUpperCase()} / INTERACTIVE STUDY</span><button class="button stage-close" id="exit-fullscreen">Exit fullscreen ×</button></div><p id="visual-status" class="work-status" role="status">Move over the field to begin.</p></div>
<aside class="control-panel visual-controls"><h2>Shape the field</h2><label>Preset<select id="visual-preset">{entry.modes.map((m,i)=><option value={i}>{m}</option>)}</select></label><label>{entry.slug==='fractal'?'Material':'Palette'}<select id="visual-palette">{(entry.slug==='fractal'?['Silver / graphite','Champagne metal','Oxidized silver','Titanium']:entry.slug==='tunnel'?['Cold starlight','Warm dust','Glacial green','Violet haze']:['Iris & ice','Solar ember','Electric mint','Rose quartz']).map((name,i)=><option value={i}>{name}</option>)}</select></label><label>{entry.slug==='fractal'?'Camera tour speed':'Speed'}<input id="visual-speed" type="range" min="0.1" max="2.5" step="0.1" value="1"/></label><label>Interaction strength<input id="visual-strength" type="range" min="0.2" max="3" step="0.1" value="1"/></label><label>{label}<input id="visual-detail" type="range" min={min} max={max} step={entry.slug==='orbit'?.1:1} value={value}/></label><label hidden={!['repulsion','gravity','mesh','flock','ribbons'].includes(entry.slug)}>Pointer behavior<select id="visual-force"><option value="1">Attract / follow</option><option value="-1">Repel / avoid</option></select></label>
<label hidden={entry.slug!=='fractal'}>Light angle<input id="visual-light" type="range" min="-3.14" max="3.14" step="0.01" value="0.7"/></label><div class="action-row"><button class="button primary" id="visual-pause">Pause</button><button class="button" id="visual-reset">Reset</button><button class="button" id="visual-random">Shuffle</button><button class="button" id="visual-fullscreen">Fullscreen</button><button class="button" id="visual-export">Save PNG</button></div>
<details open><summary>Interaction guide</summary><p id="visual-guide"></p><p>Focus the canvas to use the keys described above. Space pauses, R resets. Controls stay available in reduced motion.</p></details></aside></div>
</section><script>import '../../scripts/visuals';</script></Layout>

---
import WorldLayout from '../../layouts/WorldLayout.astro';
import '../../styles/worlds.css';
---
<WorldLayout title="Windward — a place in the wind" description="Sow a wild garden, sculpt a breeze, and keep a small world of your own. A local, living garden with 2D and 3D views.">
  <noscript><p style="position:fixed;z-index:20;top:90px;left:20px;right:20px;background:#fff9df;padding:16px">Windward needs JavaScript and Canvas for its interactive garden. WebGL is optional. You can still <a href="/worlds/">return to the world gateway</a>.</p></noscript>
  <header class="wind-header"><a href="/worlds/" class="wind-back">↖ Other skies</a><div class="wind-wordmark">Windward<span>A PLACE IN THE WIND</span></div><button id="wind-panel-toggle" aria-expanded="false" aria-controls="wind-panel">Your garden <span>☷</span></button></header>
  <main id="main"><div class="wind-scene" id="wind-scene" tabindex="0" role="region" aria-label="Interactive garden. Tools 1–4, arrows move the ground cursor, Enter applies, Space pauses. Right drag or two fingers to orbit."><div id="wind-placeholder" class="wind-placeholder"><span>01 / WINDWARD</span><h1>A little earth.<br/><em>An open sky.</em></h1><p id="wind-loading">The grass is finding its feet…</p><button id="wind-retry" hidden>Try the view again</button></div><div class="wind-vignette" aria-hidden="true"></div></div>
    <div class="wind-title" aria-hidden="true"><span>YOUR VERY OWN ELSEWHERE</span><h1>Let it<br/><em>grow wild.</em></h1></div>
    <div class="wind-bottom"><p id="wind-hint">Move across the meadow to stir the grass. Hold to leave a stronger breeze.</p><div class="wind-tools" role="toolbar" aria-label="Garden tools">{[['wind','1','Breeze'],['sow','2','Sow'],['erase','3','Erase'],['observe','4','Look']].map(([tool,key,label])=><button data-wind-tool={tool} aria-pressed={tool==='wind'} title={`${key}: ${label}`}><span>{key}</span>{label}</button>)}<i></i><button id="wind-pause" aria-pressed="false">Pause</button><button id="wind-step" title="Advance growth by one second while paused">+1s</button><i></i><button id="wind-quick-undo" aria-label="Undo last edit" title="Undo · Ctrl/⌘ Z">↶</button><button id="wind-quick-redo" aria-label="Redo last edit" title="Redo · Ctrl/⌘ Shift Z">↷</button></div><p class="wind-status" id="wind-status" role="status" aria-live="polite">Everything stays on this device. Nothing is uploaded.</p></div>
    <button id="wind-backdrop" class="world-panel-backdrop" tabindex="-1" aria-label="Close garden settings" hidden></button><aside id="wind-panel" class="wind-panel" hidden aria-label="Garden settings"><div class="wind-panel-heading"><h2>A landscape<br/><em>of your own.</em></h2><button id="wind-panel-close" aria-label="Close garden settings">×</button></div><p class="wind-small" id="wind-count">65 / 1,024 planted</p>
      <section><h3>LEAVE A LITTLE LIFE</h3><label>Plant <select id="wind-species"><option value="grass">Fine grass</option><option value="flower" selected>Wildflowers</option><option value="plume">Feather grass</option></select></label><label>Brush radius <input id="wind-radius" type="range" min="0.3" max="1.5" step="0.1" value="0.7"/></label><div class="wind-row"><button id="wind-undo">Undo</button><button id="wind-redo">Redo</button></div></section>
      <section><h3>THE WEATHER WITHIN</h3><label>Wind direction <input id="wind-direction" type="range" min="0" max="360" value="35"/><output id="wind-direction-value">35°</output></label><label>Wind strength <input id="wind-strength" type="range" min="0" max="1" step="0.01" value="0.45"/></label><label>Light <select id="wind-light"><option value="morning">Morning hush</option><option value="noon">Open daylight</option><option value="evening">Last golden hour</option></select></label></section>
      <section><h3>YOUR VIEW</h3><label>Style <select id="wind-renderer"><option value="auto">Automatic · 2D fallback</option><option value="2d">2D storybook · lighter</option><option value="3d">3D garden</option></select></label><p id="wind-renderer-note" class="wind-small">Finding your view…</p><label>Quality <select id="wind-quality"><option value="auto">Automatic</option><option value="high">High</option><option value="low">Low</option></select></label><div class="wind-row"><button id="wind-camera">Reset view</button><button id="wind-motion">Motion: Full</button></div></section>
      <section><h3>KEEP THIS CORNER</h3><label>Garden name <input id="wind-name" maxlength="80" value="A place in the wind"/></label><div class="wind-row"><button id="wind-save">Save new copy</button><button id="wind-png">Export PNG ↗</button></div><div class="wind-row"><button id="wind-export">Export garden</button><button id="wind-import">Import garden</button><input id="wind-file" type="file" accept=".json,.windward.json" hidden/></div><button id="wind-send">Prepare for Image Bench ↗</button><a id="wind-image-link" href="/tools/image/" target="_blank" rel="noopener" hidden>Open prepared snapshot ↗</a><p id="wind-dirty" class="wind-small">Not saved. Export a garden file for a backup.</p></section>
      <section><h3>ANOTHER BEGINNING</h3><label>Landscape seed <input id="wind-seed" type="number" min="0" max="4294967295" step="1" value="17"/></label><button id="wind-new">New seeded garden</button></section>
      <section><h3>YOUR LITTLE PLACES</h3><div id="wind-library"><p class="wind-small">Your saved gardens will appear here.</p></div></section>
      <details><summary>A few ways to be here</summary><p>Right-drag to orbit; scroll to move closer. Touch: one finger uses your tool, two fingers orbit and pinch. Look mode lets one finger orbit.</p><p>Focus the garden: 1–4 choose tools, arrows move the ground cursor, Enter applies, Space pauses. Ctrl/⌘ Z undoes; Shift Z redoes. One stroke is one edit. Erase never removes the base meadow.</p><p>Save makes a new copy, up to 30. No autosave, accounts, or uploads. Export an editable garden file for a backup. PNG is a picture, not an editable garden.</p></details>
    </aside>
  </main><script>import '../../scripts/windward';</script>
</WorldLayout>

---
import Layout from '../../layouts/Layout.astro';
import GameSidebar from '../../components/GameSidebar.astro';
---
<Layout title="Cosmic 2048"><section class="page-section wrap game-page"><a class="back-link" href="/play/">← Back to the arcade</a><div class="game-top"><div><div class="eyebrow">02 / STRATEGY</div><h1>Cosmic 2048<span class="muted">.</span></h1></div><div class="scoreboard"><div class="score-box"><span>SCORE</span><strong id="score">0</strong></div><div class="score-box"><span>BEST</span><strong id="best">0</strong></div></div></div><div class="game-workspace"><div class="game-board-wrap" id="game-surface" tabindex="0" aria-label="2048 game board. Use arrow keys or swipe to merge tiles."><div class="board-2048" id="board" role="group" aria-label="4 by 4 tile board"></div><div class="game-overlay" id="game-overlay" hidden><h2 id="overlay-title">A new constellation.</h2><p id="overlay-message">You reached 2048. Keep exploring?</p><button class="button primary" id="continue-game">Keep playing</button></div></div><GameSidebar/></div><p class="game-status" id="game-status" role="status">Slide to merge. Every move is a possibility.</p></section><script>import '../../scripts/game2048';</script></Layout>

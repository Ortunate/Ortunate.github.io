---
import Layout from '../../layouts/Layout.astro';
import GameSidebar from '../../components/GameSidebar.astro';
---
<Layout title="Neon Snake"><section class="page-section wrap game-page"><a class="back-link" href="/play/">← Back to the arcade</a><div class="game-top"><div><div class="eyebrow">01 / REFLEX</div><h1>Neon Snake<span class="muted">.</span></h1></div><div class="scoreboard"><div class="score-box"><span>SCORE</span><strong id="score">0</strong></div><div class="score-box"><span>BEST</span><strong id="best">0</strong></div></div></div><div class="game-workspace"><div class="game-board-wrap" id="game-surface" tabindex="0" aria-label="Snake game board. Use arrow keys or WASD to move, Space to pause."><canvas class="snake-canvas" id="snake-canvas" width="600" height="600" aria-label="Snake game">Use the direction buttons to guide the snake.</canvas><div class="game-overlay" id="game-overlay"><h2 id="overlay-title">Follow the glow.</h2><p id="overlay-message">A familiar game. A fresh orbit.<br />Ready for a little detour?</p><button class="button primary" id="start-game">Start game <span>→</span></button></div></div><GameSidebar snake/></div><p class="game-status" id="game-status" role="status"></p></section><script>import '../../scripts/snake';</script></Layout>

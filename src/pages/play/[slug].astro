---
import Layout from '../../layouts/Layout.astro';
import {games} from '../../data/catalog';
export function getStaticPaths(){return games.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
---
<Layout title={entry.title} description={entry.description}><section class="page-section wrap game-page" data-game={entry.slug}>
<div class="detail-heading"><div><a class="back-link" href="/play/">← Back to the arcade</a><h1>{entry.title}</h1><p>{entry.description}</p></div><div class="game-metrics"><div><span id="metric-label">SCORE</span><strong id="game-score">0</strong></div><div><span id="best-label">BEST</span><strong id="game-best">0</strong></div></div></div>
<div class="workspace-layout"><div class="game-stage-area"><div class="game-surface-v2" id="game-surface-v2" tabindex="0" aria-label={`${entry.title} game area`}><div class="game-grid-v2" id="game-grid" hidden></div><canvas id="arcade-canvas" width="600" height="600" aria-label={`${entry.title} board`}/><div class="game-overlay-v2" id="game-end" hidden><h2 id="game-end-title"></h2><p id="game-end-message"></p><button class="button primary" id="game-again">Play again ↗</button><button class="button" id="game-continue" hidden>Keep playing</button></div></div><div class="touch-controls" aria-label="Game controls"><button data-game-key="ArrowLeft" aria-label="Move left">←</button><button data-game-key="ArrowUp" aria-label="Move up or rotate">↑</button><button data-game-key="ArrowDown" aria-label="Move down">↓</button><button data-game-key="ArrowRight" aria-label="Move right">→</button><button data-game-key="Enter" aria-label="Primary action">↵</button><button data-game-key=" " aria-label="Select or drop">␣</button></div><p id="game-status-v2" class="work-status" role="status"></p></div>
<aside class="control-panel"><h2>Make it your game</h2><label>Mode<select id="game-mode">{entry.modes.map((m,i)=><option value={i}>{m}</option>)}</select></label><div class="action-row"><button class="button primary" id="game-restart">New game</button><button class="button" id="game-pause">Pause</button></div><div class="game-extra-controls" id="game-extra"></div><details open><summary>How to play</summary><p id="game-rules" class="game-instructions"></p></details><p class="help-text">Your scores stay in this browser. Click the board to use the keyboard.</p></aside></div>
</section><script>import '../../scripts/arcade';</script></Layout>
